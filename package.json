{
  "name": "coin-scout",
  "version": "0.0.0-development",
  "description": "Read-only Solana MCP server for on-chain analysis and fraud investigation, backed by Helius",
  "type": "module",
  "bin": {
    "coin-scout": "./build/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build/**/*.js"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "bundle": "esbuild src/standalone.ts --bundle --platform=node --format=esm --target=node22 --outfile=build/coin-scout.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "mcpb": "tsx scripts/mcpb.ts",
    "dev": "tsx src/index.ts",
    "http": "tsx src/http.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "stdio-load": "tsx scripts/stdio-load.ts",
    "verify-fixes": "tsx scripts/verify-fixes.ts",
    "validate": "tsx scripts/validate.ts"
  },
  "keywords": [
    "mcp",
    "solana",
    "helius",
    "blockchain",
    "fraud-detection",
    "onchain-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisyilmaz/coin-scout.git"
  },
  "homepage": "https://github.com/dennisyilmaz/coin-scout#readme",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
