HELIUS_API_KEY=your-helius-api-key
HELIUS_NETWORK=mainnet

# Raising HELIUS_MAX_CONCURRENCY past your Helius plan's req/s triggers 429 backoff.
HELIUS_MAX_CONCURRENCY=24
HELIUS_CONNECTIONS=64
HELIUS_HTTP2=true
HELIUS_BATCH_WINDOW_MS=4
HELIUS_MAX_BATCH_SIZE=20
HELIUS_TIMEOUT_MS=30000
HELIUS_MAX_RETRIES=6
HELIUS_CACHE_ENTRIES=20000
COIN_SCOUT_MAX_TRACE_NODES=400
COIN_SCOUT_MAX_PAGES=20
